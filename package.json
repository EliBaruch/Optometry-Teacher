{
  "name": "optometry-teacher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Seven Sins Eye Clinic — an animated optometry diagnosis game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:mod": "node scripts/check-module.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:boundaries && npm run test && vite build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
